        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TOOLS": "ON",
        "BUILD_MULTISIG_CLI": "OFF",
        "BUILD_GENESIS_CLI": "OFF"
      }
