<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/images">
        <file alias="background">res/images/background.png</file>
        <file alias="background_dark">res/images/background_dark.png</file>
    </qresource>
    <qresource prefix="/translations">
        <file alias="geocoin_en.qm">translations/geocoin_en.qm</file>
        <file alias="geocoin_ru.qm">translations/geocoin_ru.qm</file>
    </qresource>
    <qresource prefix="/icons">
        <!-- Main icons -->
        <file alias="geocoin">res/icons/geocoin.png</file>
        <file alias="spin_up_dark">res/icons/spin_up_dark.xpm</file>
        <file alias="spin_down_dark">res/icons/spin_down_dark.xpm</file>
        <file alias="spin_up_light">res/icons/spin_up_light.xpm</file>
        <file alias="spin_down_light">res/icons/spin_down_light.xpm</file>
        <!-- <file alias="about">res/icons/about.png</file> -->
        <!-- <file alias="quit">res/icons/quit.png</file> -->

        <!-- Page icons -->
